{
  "name": "clyp",
  "version": "1.0.6",
  "description": "Fast, Private, Cross-Platform Clipboard Manager",
  "author": "Clyp rameshchinnu61@gmail.com",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --bundles dmg",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles deb,appimage",
    "test": "npm run test:ui && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "generate-icons": "./scripts/generate-icons.sh",
    "test:ui": "node scripts/run-ui-tests.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "jsdom": "^25.0.1"
  }
}
